{
  "name": "hirebox-skill-manager-portable",
  "version": "0.1.0",
  "description": "Portable Hirebox Skill Manager package. Download and run with Node.js installed.",
  "entrypoints": {
    "windowsCmd": "hirebox-skill-manager-portable\\hirebox.cmd",
    "powershell": "hirebox-skill-manager-portable\\hirebox.ps1",
    "unixShell": "hirebox-skill-manager-portable/hirebox",
    "bash": "hirebox-skill-manager-portable/hirebox.sh",
    "node": "hirebox-skill-manager-portable\\src\\index.js"
  },
  "requirements": [
    "Node.js",
    "Git"
  ],
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "distribution": {
    "mode": "portable",
    "archive": "hirebox-skill-manager-portable.zip"
  }
}
